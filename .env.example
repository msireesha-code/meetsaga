# MeetSage environment configuration
# Copy to .env and adjust. Never commit the real .env file.

# --- General ---
APP_NAME=MeetSage
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/meetsage.db
DEFAULT_ANALYSIS_LANGUAGE=en

# --- Transcription ---
DEFAULT_TRANSCRIPTION_PROVIDER=local
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_CPU_THREADS=0
MAX_CONCURRENT_JOBS=1

# --- Speaker Diarization ---
DIARIZATION_ENABLED=true
# Required to download pyannote/speaker-diarization-3.1 and pyannote/segmentation-3.0.
# Get a token at https://huggingface.co/settings/tokens and accept the model license terms
# at https://huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=

# --- LLM / Analysis (OpenAI-compatible endpoint) ---
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=120

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=2048

# --- CORS (only relevant when the frontend runs as a separate dev server;
# ignored when the backend serves a built frontend/dist itself) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
